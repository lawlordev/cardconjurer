{
  "$schema": "https://loomcode.dev/loom.schema.json",
  "version": 1,
  "toolchain": {"node": "24", "npm": "11", "python": "3.13"},
  "install": "npm ci",
  "build": "npm run build:desktop",
  "test": "npm test",
  "targets": [
    {
      "id": "web",
      "name": "Card editor (browser)",
      "kind": "url",
      "platform": "web",
      "command": "py=python3; $py -c '' 2>/dev/null || py=python; exec $py dev_server.py --host 127.0.0.1 --port \"${PORT:-8081}\"",
      "health": "/"
    },
    {
      "id": "desktop",
      "name": "Set Conjurer desktop app",
      "kind": "stream",
      "platform": "electron",
      "command": "npm start"
    }
  ],
  "releases": [
    {
      "id": "app",
      "name": "Desktop app (macOS + Windows)",
      "paths": [
        "*", ".github/**", "about/**", "askurza/**", "converter/**", "core/**", "creator/**", "css/**",
        "data/**", "desktop/**", "docker/**", "docs/*", "docs/releases/**", "fonts/**", "gallery/**",
        "generated/**", "globalHTML/**", "img/*", "img/manaSymbols/**", "img/samples/**", "img/tutorial/**",
        "img/watermarks/**", "img/frames/cornerCutout.png", "img/frames/maskRightHalf.png",
        "img/frames/maskMiddleThird.png", "img/frames/serial.png", "js/**", "legal/**", "local_art/**",
        "packs/**", "phyrexian/**", "print/**", "resources/**", "scripts/**", "tests/**", "theme/**",
        "tutorial/**", "vendor/**"
      ],
      "command": "node scripts/loom-release.mjs app",
      "prepare": true
    },
    {
      "id": "packs",
      "name": "Content packs",
      "paths": [
        "packs/**", "img/frames/**", "img/setSymbols/**", "js/frames/**", "js/mseKeywordCatalog.js",
        "js/frameRegistry.js", "js/frameSearch.js", "vendor/mse/**", "scripts/compile-mse-keywords.mjs",
        "scripts/build-frame-pack-release.mjs", "scripts/compile-frame-packs.mjs",
        "scripts/lib/pack-ownership.mjs", "scripts/validate-frame-packs.mjs",
        ".github/workflows/release-frame-packs.yaml"
      ],
      "command": "node scripts/loom-release.mjs packs",
      "prepare": true
    }
  ]
}
